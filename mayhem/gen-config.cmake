# Generates the configure-time headers of OpenMS (what upstream's CMake does) without Arrow/HiGHS/etc.
# usage: cmake -DSRC=<repo root> -DOUT=<dir> -P gen-config.cmake
set(PROJECT_SOURCE_DIR ${SRC}/src/openms)
set(PROJECT_BINARY_DIR ${OUT})
set(OPENMS_64BIT_ARCHITECTURE ON)
set(OPENMS_HAS_UNISTD_H ON)
set(OPENMS_HAS_TIME_H ON)
set(OPENMS_HAS_SYS_TIMES_H ON)
set(OPENMS_HAS_SYS_TIME_H ON)
set(OPENMS_HAS_SYS_RESOURCE_H ON)
set(OPENMS_HAS_KILL ON)
set(OPENMS_HAS_SYSCONF ON)
set(CF_OPENMS_ASSERTIONS 0)
set(CF_SOURCE_PATH_SIZE 0)
set(CF_OPENMS_LIBSVM_VERSION 324)
set(CF_OPENMS_LIBSVM_VERSION_MAJOR 3)
set(CF_OPENMS_LIBSVM_VERSION_MINOR 24)
set(CF_OPENMS_BOOST_VERSION_MAJOR 1)
set(CF_OPENMS_BOOST_VERSION_MINOR 83)
set(CF_OPENMS_BOOST_VERSION_SUBMINOR 0)
set(CF_OPENMS_BOOST_VERSION 108300)
set(CF_MYCXXFLAGS "<none>")
set(CF_OPENMS_DATA_PATH ${SRC}/share/OpenMS)
set(CF_OPENMS_DOC_PATH ${SRC}/doc)
set(CF_OPENMS_INSTALL_DATA_PATH ${SRC}/share/OpenMS)
set(CF_OPENMS_INSTALL_DOC_PATH ${SRC}/doc)
set(CF_OPENMS_BUILD_TOOL_REGISTRY_PATH ${SRC}/share/OpenMS)
set(CF_OPENMS_PACKAGE_VERSION_FULLSTRING "3.7.0")
set(OPENMS_GIT_SHORT_SHA1 "unknown")
set(OPENMS_GIT_SHORT_REFSPEC "develop")
foreach(h config.h openms_data_path.h openms_package_version.h)
  configure_file(${PROJECT_SOURCE_DIR}/include/OpenMS/${h}.in ${OUT}/OpenMS/${h})
endforeach()
file(WRITE ${OUT}/OpenMS/OpenMSConfig.h "#pragma once\n#define OPENMS_DLLAPI\n#define OPENMS_NO_EXPORT\n#define OPENMS_DEPRECATED\n")
file(WRITE ${OUT}/OpenMS/OPENSWATHALGO/OpenSwathAlgoConfig.h "#pragma once\n#define OPENSWATHALGO_DLLAPI\n#define OPENSWATHALGO_NO_EXPORT\n")
file(WRITE ${OUT}/IsoSpec/IsoSpecExport.h "#pragma once\n#define OPENMS_EXPORT\n#define OPENMS_NO_EXPORT\n")
